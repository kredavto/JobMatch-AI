SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Required for mail links; exact canonical HTTPS origin, no user-controlled redirects.
APP_URL=https://your-app.example

# Optional self-hosted AI; disabled until an operator configures its own service.
JOBMATCH_AI_ENABLED=false
JOBMATCH_AI_SELF_HOSTED=false
JOBMATCH_AI_ENDPOINT=https://your-own-inference.example/api/chat
JOBMATCH_AI_MODEL=your-reviewed-model
JOBMATCH_AI_TOKEN=

# Compatibility default. Switch only after provisioning/testing the owned isolated worker.
IMPORT_PARSER_MODE=inline
# Worker mode requires an owned HTTPS /extract endpoint and a separate 32-128 character token.
IMPORT_PARSER_URL=
IMPORT_PARSER_TOKEN=

# Optional shared pre-auth quotas: provision matching private DB key before required.
JOBMATCH_AUTH_QUOTA_MODE=local
JOBMATCH_AUTH_QUOTA_SECRET=

# Enable the web acceptance route only after operator publication of a reviewed notice.
# Direct authenticated RPCs are gated by active catalog rows; keep drafts inactive.
JOBMATCH_CONSENT_ACCEPTANCE_ENABLED=false

# Optional server-only operational events: exact stdout enables bounded coarse route metadata.
# Default/unknown/off = disabled. No external sink/alerts. Review log access/retention/budget before activation.
JOBMATCH_OPS_TELEMETRY=off

# Opt-in own-endpoint quote grammar. legacy keeps the original prompt/format.
# source-lines-v1 allows only bounded eligible whole trimmed vacancy lines;
# source constraints do not verify meaning or accept the model. AI remains separately disabled.
JOBMATCH_AI_QUOTE_CONTRACT=legacy

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Required for mail links; exact canonical HTTPS origin, no user-controlled redirects.
APP_URL=https://your-app.example

# Optional self-hosted AI; disabled until an operator configures its own service.
JOBMATCH_AI_ENABLED=false
JOBMATCH_AI_SELF_HOSTED=false
JOBMATCH_AI_ENDPOINT=https://your-own-inference.example/api/chat
JOBMATCH_AI_MODEL=your-reviewed-model
JOBMATCH_AI_TOKEN=

# Experimental features stay disabled until separately reviewed and configured.
JOBMATCH_AI_ADAPTATION_ENABLED=false
JOBMATCH_HH_VACANCY_IMPORT=disabled
# After approved HH application registration and terms/data-use review only:
# JOBMATCH_HH_USER_AGENT=YourApp/1.0 (operator@example.com)
# JOBMATCH_HH_APP_ACCESS_TOKEN=server-only application token

# Saved-letter storage is independent of AI and off by default. Never use fixture keys.
JOBMATCH_SAVED_LETTERS_ENABLED=false
JOBMATCH_LETTER_SIGNING_SECRET=

# Extra source copy requires separate operator approval and native capability grant. Default OFF.
JOBMATCH_SOURCE_PROFILE_ENABLED=false

# Separate pre-auth quota key; never NEXT_PUBLIC, default compatibility only.
JOBMATCH_AUTH_QUOTA_MODE=local
JOBMATCH_AUTH_QUOTA_SECRET=

# Compatibility default. Worker requires approved owned HTTPS hosting and privacy decisions.
IMPORT_PARSER_MODE=inline
IMPORT_PARSER_URL=
IMPORT_PARSER_TOKEN=

{
  "name": "jobmatch-ai",
  "version": "0.34.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "test:security": "node --test security/tests/*.test.mjs",
    "audit:dependencies": "node scripts/dependency_audit.mjs",
    "audit:dependencies:all": "node scripts/dependency_audit.mjs --require-all",
    "build:parser-worker": "tsc -p worker/tsconfig.json",
    "test:parser-worker": "npm run build:parser-worker && node --test worker/tests/*.test.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "0.1.80",
    "jszip": "3.10.2",
    "mammoth": "^1.11.0",
    "next": "16.4.3",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "yauzl": "3.2.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.58.2",
    "@sparticuz/chromium": "133.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/yauzl": "2.10.3",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree@8.72.0": {
      "minimatch": "11.0.3"
    }
  }
}

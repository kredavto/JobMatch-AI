{
  "name": "jobmatch-ai",
  "version": "0.34.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "build:parser-worker": "tsc -p worker/tsconfig.json",
    "test:parser-worker": "npm run build:parser-worker && node --test worker/tests/supervisor.test.mjs worker/tests/ocr.test.mjs worker/tests/clamav.test.mjs worker/tests/scan-gate.test.mjs worker/tests/scanner-readiness.test.mjs worker/tests/scanner-attestation.test.mjs worker/tests/scanner-observer-client.test.mjs worker/tests/scanner-measurement.test.mjs",
    "build:ai-evaluation": "tsc -p evaluation/tsconfig.json",
    "evaluate:ai": "npm run build:ai-evaluation --silent && node evaluation/dist/evaluation/run.cjs",
    "test:ai-evaluation": "npm run build:ai-evaluation && node --test evaluation/tests/runtime.test.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "0.1.80",
    "mammoth": "^1.11.0",
    "next": "16.4.3",
    "pdfjs-dist": "^5.4.624",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "yauzl": "3.2.0",
    "zod": "^4.3.6",
    "jszip": "3.10.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.58.2",
    "@sparticuz/chromium": "133.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/yauzl": "2.10.3",
    "esbuild": "0.28.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
